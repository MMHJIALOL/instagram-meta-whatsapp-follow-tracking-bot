VERIFY_TOKEN=pick-any-random-string
APP_SECRET=your-instagram-app-secret
IG_ACCESS_TOKEN=your-long-lived-instagram-user-token
IG_USER_ID=your-instagram-professional-account-id
# WORKSHOP_LINK, WORKSHOP_SINCE, WA_MAIN_CHAT and MEET_URL only set up the first workshop; after that they're
# edited on the dashboard's Workshop tab (stored in bot.db), and changing them here does nothing.
WORKSHOP_LINK=https://whatsapp.com/channel/XXXX
# Word a plain DM must contain to trigger (case-insensitive). * = every DM. Comments, story replies and ad DMs always trigger.
KEYWORD=workshop

# Comments/story replies only trigger on posts made at or after this time. Ads always trigger. Empty = all posts.
START_AFTER=2026-10-02T21:45:00+05:30
# Optional permanent HTTPS address serving this bot; leave empty to use the current temporary tunnel.
# A permanent host/tunnel must be configured before setting this.
PUBLIC_LINK_BASE=
CONTACT_NUMBER=+91 XXXXX XXXXX

# comma-separated media ids the bot ignores comments on (even ads); DMs still work
IGNORE_MEDIA=
JOIN_SERVICE_BASE=
JOIN_SYNC_TOKEN=
